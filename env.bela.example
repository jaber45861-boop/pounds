# Copy this file to .env on Bela and replace every placeholder.
# Never commit the real .env file or share its values.

# Telegram bot
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
SMM_API_KEY=replace_with_smm_api_key

# Server-only reward security
SESSION_SECRET=replace_with_a_long_random_secret
API_SECRET=replace_with_a_different_long_random_secret

# Existing SQLite database. Use the exact uploaded database filename/path.
BOT_DB_PATH=attached_assets/users_(3)_1785867154340.db

# Bela HTTP service
PORT=8000
API_HOST=0.0.0.0
HTTP_THREADS=8

# Public Mini App and CORS
TELEGRAM_MINI_APP_URL=https://mini-app.example.com
REWARD_API_ORIGINS=https://mini-app.example.com

# Monetag
MONETAG_ZONE_ID=replace_with_monetag_zone_id
MONETAG_SDK_URL=https://libtl.com/sdk.js
MONETAG_SDK_NAME=show_replace_with_monetag_zone_id
ADVERTISING_URL=https://replace-with-your-advertising-url
SMM_API_URL=https://replace-with-your-smm-provider/api/v2

# Frontend build-time values (used when building the Mini App)
VITE_REWARD_API_URL=https://api.example.com
VITE_REWARD_TASK_ID=monetag_rewarded_ad
VITE_MONETAG_ZONE_ID=replace_with_monetag_zone_id
VITE_MONETAG_SDK_URL=https://libtl.com/sdk.js
VITE_MONETAG_SDK_NAME=show_replace_with_monetag_zone_id